# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Salidas de las corridas de Maestro. Los screenshots y las jerarquías de
# pantalla de un fallo sirven para depurar y no tienen nada que hacer en el
# repo: pesan, cambian en cada corrida y ensucian cualquier diff.
.maestro-*
/.maestro/

# Capturas de la auditoría de responsive (scripts/responsive/): son
# artefactos de una corrida, no código. El repo lleva la auditoría, no sus
# fotos.
/reports/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.db
*.db-journal
/prisma/dev.db*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …pero .env.example SÍ se versiona, y el `!` no es opcional: sin esta línea el
# patrón de arriba se lo come, y el archivo que documenta qué variables existen
# es justamente el que nadie que clona el repo puede reconstruir solo.
!.env.example

# vercel
.vercel

# neon local link state
.neon

# typescript
*.tsbuildinfo
next-env.d.ts
.neon

# local planning docs (not versioned)
ROADMAP.md

# backups de base de datos
/backups/
