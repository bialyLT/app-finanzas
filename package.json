{
  "name": "proyectos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:test:setup": "node scripts/db-test-setup.mjs",
    "smoke": "node scripts/smoke.mjs",
    "flows": "powershell -ExecutionPolicy Bypass -File scripts/flows.ps1",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:local:start": "powershell -ExecutionPolicy Bypass -File scripts/db-local.ps1 start",
    "db:local:stop": "powershell -ExecutionPolicy Bypass -File scripts/db-local.ps1 stop",
    "db:local:status": "powershell -ExecutionPolicy Bypass -File scripts/db-local.ps1 status",
    "db:local:reset": "powershell -ExecutionPolicy Bypass -File scripts/db-local.ps1 reset",
    "auth:hash": "node scripts/hash-password.mjs",
    "auth:secret": "node scripts/generate-secret.mjs"
  },
  "dependencies": {
    "@neon/config": "^1.4.2",
    "@neon/env": "^1.3.2",
    "@prisma/client": "^6.19.3",
    "date-fns": "^4.4.0",
    "next": "^16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
