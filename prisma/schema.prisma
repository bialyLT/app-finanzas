// ═════════════════════════════════════════════════════════════════════════════
// MODELO DE DATOS — Mis Finanzas
// ═════════════════════════════════════════════════════════════════════════════
//
// LA REGLA CENTRAL DEL MODELO
// ─────────────────────────────────────────────────────────────────────────────
// Un movimiento de plata entre DOS BOLSILLOS TUYOS nunca es un ingreso ni un
// gasto. Es una TRANSFERENCIA.
//
// Suena obvio y es exactamente lo que el modelo anterior no podía expresar:
// tenía sólo `INCOME` y `EXPENSE`, así que pagar la tarjeta, pasarte plata del
// banco al efectivo o cobrar un préstamo sólo se podían registrar como gasto o
// ingreso — y las dos cosas son mentira. El resultado es que los números de la
// app describían una economía que no era la tuya.
//
// EL CASO QUE LO EXPONE (números reales de este proyecto):
//   Sueldo 800.000 · Gastos 600.000 · Préstamo 500.000 a TNA 60% en 12 cuotas
//
//   Modelo viejo: la cuota entera (≈55.000) es un "gasto"  → ahorro = 49,51%
//   Modelo nuevo:  de esa cuota, apenas el 26,14% es interés real.
//                  El 73,86% restante es amortización de capital: bajás deuda,
//                  no perdés plata.
//                  → ahorro real = 21,88%
//
// La diferencia entre 49,51% y 21,88% no es un detalle de redondeo: es la
// diferencia entre creerte rico y serlo.
//
// ─────────────────────────────────────────────────────────────────────────────
// LOS TRES TIPOS DE MOVIMIENTO
// ─────────────────────────────────────────────────────────────────────────────
//   INCOME    → la plata entra al sistema desde afuera   (sueldo, venta)
//   EXPENSE   → la plata sale del sistema hacia afuera   (supermercado, interés)
//   TRANSFER  → la plata se mueve DENTRO del sistema     (pagar la tarjeta,
//                                                         pasarme a efectivo)
//
// ─────────────────────────────────────────────────────────────────────────────
// CÓMO SE MODELA UN PRÉSTAMO Y UNA TARJETA
// ─────────────────────────────────────────────────────────────────────────────
// No son "tipos de gasto": son CUENTAS, y son cuentas de PASIVO (saldo negativo).
//
//   Tarjeta de crédito
//     Compra con tarjeta  → EXPENSE con accountId = la tarjeta.
//                           La tarjeta queda en −X: debés X.
//     Pagás el resumen    → TRANSFER del banco a la tarjeta.
//                           Baja el banco y baja la deuda. NO es un gasto:
//                           ya lo registraste cuando compraste. Contarlo dos
//                           veces es el error más común de las apps de finanzas.
//
//   Préstamo
//     Te lo desembolsan   → TRANSFER de la cuenta préstamo a tu banco.
//                           El préstamo queda en −500.000 y el banco sube.
//                           Patrimonio neto: sin cambios. Cobrar un préstamo
//                           NO es un ingreso.
//     Pagás la cuota      → DOS movimientos, que es lo que realmente pasa:
//                           · TRANSFER banco → préstamo  (amortizás capital)
//                           · EXPENSE desde el banco      (el interés, que sí
//                                                           es plata perdida)
//
// El interés es el único costo real del préstamo, y por eso es lo único que
// aparece como gasto. Todo lo demás es mover plata entre tus propios bolsillos.
//
// ─────────────────────────────────────────────────────────────────────────────
// LOS DOS ERRORES DE PRECISIÓN QUE ESTE ESQUEMA ELIMINA
// ─────────────────────────────────────────────────────────────────────────────
// 1. Float para plata. `Float` es IEEE-754 binario: no puede representar 0,10
//    de forma exacta. Acumulado en cientos de movimientos, el saldo deja de
//    cerrar y la app "pierde" centavos. Acá: Decimal(18,2) — aritmética exacta,
//    la misma que usa cualquier sistema contable.
//    (Decimal(18,2) llega hasta 9.999.999.999.999.999,99. Un `Int` de centavos
//     se queda corto en $21.474.836,47 — ridículo en pesos argentinos.)
//
// 2. `DateTime` para fechas de calendario. Una fecha de calendario no tiene
//    hora ni zona horaria: "el alquiler vence el 1 de noviembre" es cierto en
//    Buenos Aires y en Tokio. Guardarla como instante hace que un gasto del
//    1 de noviembre aparezca en octubre si el servidor corre en UTC.
//    Acá: @db.Date — sin hora, sin zona, sin ambigüedad.
//
//    Verificado en esta máquina (TZ America/Buenos_Aires, UTC−3):
//      · new Date("2026-10-15") se mostraba como "14 oct" — un día menos.
//      · new Date("2026-11-01T00:00:00Z").getDate() devolvía 31 → el gasto de
//        noviembre se contaba en octubre.
//      · El mes de octubre abarcaba [01/10 03:00Z … 01/11 02:59:59Z], así que
//        TODO el 1 de noviembre entraba en el balance de octubre.
// ═════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

/// Tipo de cuenta.
///
/// ─────────────────────────────────────────────────────────────────────────────
/// PASIVO vs ACTIVO ES LA DISTINCIÓN QUE MANDA
/// ─────────────────────────────────────────────────────────────────────────────
///   · CASH / BANK / RECEIVABLE → ACTIVOS (plata tuya, o plata que te deben).
///   · CREDIT_CARD / LOAN       → PASIVOS (plata que debés).
///
/// `RECEIVABLE` (Fase 4) es el espejo de `LOAN`: un préstamo que VOS diste. Su
/// saldo es POSITIVO (lo que te deben) y suma al patrimonio como activo — jamás
/// cae del lado de las deudas (`isLiability` sólo mira LOAN y CREDIT_CARD). La
/// dirección de un préstamo se DERIVA de acá (`loanDirectionOf` en lib/loans.ts):
/// `LOAN` = I_OWE, `RECEIVABLE` = OWED_TO_ME. No hay un campo aparte que pueda
/// contradecir al kind.
enum AccountKind {
  /// Efectivo, billetera, caja de ahorro en pesos.
  CASH
  /// Cuenta bancaria, billetera virtual (Mercado Pago, Ualá).
  BANK
  /// Tarjeta de crédito. Es una cuenta de deuda, no un medio de pago mágico.
  CREDIT_CARD
  /// Préstamo, crédito, financiación en cuotas. Vos debés.
  LOAN
  /// Préstamo que DISTE: te deben. Es un ACTIVO, no una deuda.
  RECEIVABLE
}

/// Sistema de amortización: cómo se devuelve el capital de un préstamo.
///
/// Los cinco viven en `lib/loans.ts` con sus fórmulas y su documentación. La
/// columna que usa este enum admite NULL en las cuentas creadas antes de la
/// Fase 4, y `NULL` se LEE como FRENCH (era el único sistema que existía):
/// `systemOf()` hace esa traducción en un solo lugar.
enum AmortizationSystem {
  /// Cuota constante: pagás lo mismo todos los meses (los bancos argentinos).
  FRENCH
  /// Capital constante: cada cuota amortiza lo mismo y el pago baja mes a mes.
  GERMAN
  /// Interés periódico y todo el capital en la última cuota (bullet).
  AMERICAN
  /// Rotativo: sólo interés, el capital no se amortiza por contrato.
  INTEREST_ONLY
  /// El cronograma lo dicta un documento externo: se valida, no se recalcula.
  IMPORTED
}

/// Tipo de movimiento. Ver la explicación de arriba.
enum MovementKind {
  INCOME
  EXPENSE
  TRANSFER
}

/// Tipo de categoría. Es un enum SEPARADO de MovementKind a propósito: así es
/// imposible en el tipo crear una categoría de tipo TRANSFER. Las
/// transferencias no se categorizan porque no son ni ingreso ni gasto —
/// y el sistema no te debería dejar decir lo contrario.
enum CategoryKind {
  INCOME
  EXPENSE
}

/// Cada cuánto se repite una regla de recurrencia.
///
/// Sólo cuatro frecuencias, y a propósito: son las que la persona realmente
/// usa para las cuentas fijas (todos los días, todas las semanas, todos los
/// meses, todos los años) y las cuatro se pueden expresar sobre fechas de
/// CALENDARIO sin ambigüedad. "Cada 15 días" ya se escribe como `WEEKLY` con
/// `interval = 2`, y "cada 2 meses" como `MONTHLY` con `interval = 2`.
enum RecurFreq {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

/// Qué hace el sistema cuando una ocurrencia VENCE.
///
/// La distinción no es de comodidad: es la diferencia entre un hecho y una
/// promesa. El sueldo que ya se acreditó es un hecho (AUTO). El alquiler que
/// todavía no pagaste es una promesa (NOTIFY): la app te lo recuerda, pero no
/// lo da por pagado sin que lo confirmes.
enum PostingMode {
  /// Postea el movimiento solo. La plata ya se movió: no hay nada que confirmar.
  AUTO
  /// Encola la ocurrencia en la bandeja para que la persona acepte o salte.
  NOTIFY
}

/// Estado de una regla.
///
/// Es UN enum con tres valores mutuamente excluyentes y no dos booleanos
/// (`active` + `archived`) por el mismo motivo por el que `MovementKind` define
/// el signo: dos booleanos representan estados imposibles ("activa Y
/// archivada") que después hay que defender en cada consulta.
enum RecurrenceRuleStatus {
  /// Genera ocurrencias.
  ACTIVE
  /// No genera nada, pero sigue a la vista para poder reactivarla.
  PAUSED
  /// Fuera de la vista. Las ocurrencias y movimientos que ya generó quedan.
  ARCHIVED
}

/// Estado de UNA ocurrencia de una regla (una fila = una fecha del calendario).
///
/// La ocurrencia es el registro de "qué pasó con esta fecha": sin ella, saltar
/// una ocurrencia sería un borrado —la próxima corrida del generador la
/// volvería a crear— y el pasado se reescribiría solo.
enum RecurrenceOccurrenceStatus {
  /// Vencida y sin resolver: espera en la bandeja.
  PENDING
  /// Posteada: existe un movimiento con esta fecha. `movementId` lo apunta.
  POSTED
  /// Saltada a propósito. La marca QUEDA: esta fecha no se vuelve a generar.
  SKIPPED
}

// ─────────────────────────────────────────────────────────────────────────────
// Account — los bolsillos
// ─────────────────────────────────────────────────────────────────────────────

/// Un "bolsillo": dónde está tu plata o cuánta debés.
///
/// Las cuentas NO se borran, se ARCHIVAN. Borrar una cuenta dejaría sus
/// movimientos huérfanos y con ellos se iría la explicación de cómo llegaste
/// a tu patrimonio actual. El historial es el producto.
model Account {
  id String @id @default(cuid())

  /// Nombre visible: "Efectivo", "Banco Galicia", "Visa Santander".
  name String
  kind AccountKind

  /// Saldo inicial de la cuenta.
  ///
  /// Existe para que puedas empezar a usar la app HOY sin cargar tres años de
  /// movimientos viejos. En un préstamo ya desembolsado, acá va lo que todavía
  /// debés (en negativo).
  openingBalance Decimal @default(0) @db.Decimal(18, 2)

  /// Mes en el que el saldo inicial cuenta como INGRESO de ese mes.
  ///
  /// NULL = la bandera apagada, que es el comportamiento de siempre: el saldo
  /// inicial es un STOCK (la plata que ya tenías) y no entra en los ingresos de
  /// ningún mes.
  ///
  /// Con valor, el mes (el PRIMER día, en calendario) es el período al que el
  /// saldo se suma como ingreso: "esta plata que declaré, contala como ingreso
  /// de este mes".
  ///
  /// Sólo tiene sentido en cuentas de DINERO (CASH/BANK) con saldo POSITIVO:
  /// un saldo negativo es un pasivo (una deuda ya desembolsada) y una deuda no
  /// es un ingreso. Un CHECK en la base lo hace cumplir (migración
  /// `20261021120000_banderita_ingreso_de_saldo`).
  openingIncomeMonth DateTime? @db.Date

  // ── Parámetros del préstamo. Sólo se usan si kind = LOAN o RECEIVABLE ────

  /// Monto original que te prestaron (LOAN) o que prestaste (RECEIVABLE).
  principal Decimal? @db.Decimal(18, 2)

  /// Tasa Nominal Anual en PORCENTAJE (60 significa 60% TNA, no 0,60).
  ///
  /// Se guarda el porcentaje y no la fracción porque es como lo dice el banco:
  /// "TNA 60%". Si guardásemos 0,60, alguien iba a asumir que 60 es 60.
  tnaPercent Decimal? @db.Decimal(7, 4)

  /// Cuántas cuotas pactaste en total.
  installmentCount Int?

  /// Fecha de la primera cuota. Las siguientes se calculan sumando meses
  /// (con clamp de fin de mes contra esta ANCLA: 31 de enero → 28 de febrero →
  /// 31 de marzo, como la recurrencia y las tarjetas).
  firstInstallmentDate DateTime? @db.Date

  /// Sistema con el que se devuelve el capital. NULL = cuenta anterior a la
  /// Fase 4; se lee como FRENCH (`systemOf`). Obligatoria de hecho para el
  /// sistema IMPORTED, que no tiene tasa de la que derivar el cronograma.
  amortizationSystem AmortizationSystem?

  // ── Parámetros de la tarjeta. Sólo se usan si kind = CREDIT_CARD ──────────

  /// Día del mes del CIERRE del resumen (1..31).
  ///
  /// Es un ANCLA al estilo de `RecurrenceRule.dayOfMonth`: en los meses más
  /// cortos se clampea (31 → 30 de abril, 28/29 de febrero). Un cierre "31"
  /// significa "el último día del mes", no un día que no existe.
  ///
  /// El rango 1..31 lo hace cumplir un CHECK junto con `dueDay`: o están los
  /// dos, o no está ninguno. `closingDay` sin `dueDay` no describe nada (un
  /// resumen sin vencimiento) y la app no sabría qué hacer con él.
  closingDay Int?

  /// Día del mes del VENCIMIENTO del resumen (1..31).
  ///
  /// ─────────────────────────────────────────────────────────────────────────
  /// DÍA FIJO DEL MES, NO "DÍAS DESPUÉS DEL CIERRE"
  /// ─────────────────────────────────────────────────────────────────────────
  /// Es como lo dice el banco ("cierra el 25 y vence el 5") y no depende del
  /// largo del mes: "vence 10 días después del cierre" un 25 de febrero daría
  /// un 7 de marzo en un año y un 6 en otro. La fecha de vencimiento es el
  /// primer `dueDay` (clampeado) ESTRICTAMENTE posterior al cierre:
  ///
  ///   · cierra 25, vence 5   → 5 del mes siguiente (el caso típico)
  ///   · cierra 5,  vence 20  → 20 del mismo mes
  ///   · cierra 25, vence 25  → 25 del mes siguiente (el cierre va primero)
  ///
  /// El cálculo vive en `lib/cards.ts` (`dueDateOf`) y está testeado.
  dueDay Int?

  /// Límite de compra de la tarjeta, para mostrar la utilización
  /// (`deuda / límite`). NULL = la persona no lo cargó: la app dice "no se
  /// sabe", nunca un 0% inventado.
  creditLimit Decimal? @db.Decimal(18, 2)

  /// Las cuentas archivadas no aparecen al cargar movimientos, pero su historia
  /// sigue contando en los totales.
  archived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Movimientos que SALEN de esta cuenta (o donde entra un ingreso).
  movements Movement[] @relation("MovementFromAccount")

  /// Transferencias que LLEGAN a esta cuenta.
  incomingTransfers Movement[] @relation("MovementToAccount")

  /// Reglas de recurrencia que salen de esta cuenta (o donde entra el ingreso).
  recurrenceRules RecurrenceRule[] @relation("RecurrenceRuleAccount")

  /// Reglas de recurrencia cuyo destino es esta cuenta (sólo en TRANSFER).
  incomingRecurrenceRules RecurrenceRule[] @relation("RecurrenceRuleToAccount")

  /// Planes de cuotas de esta tarjeta (sólo si kind = CREDIT_CARD).
  cardPlans CardPlan[] @relation("CardPlanAccount")

  /// Resúmenes de esta tarjeta (sólo si kind = CREDIT_CARD).
  statements Statement[] @relation("CardStatements")

  /// El cronograma materializado del préstamo (sólo LOAN o RECEIVABLE).
  installments Installment[] @relation("LoanInstallments")

  /// Plantillas que usan esta cuenta como origen (o donde entra el ingreso).
  favoriteTemplates FavoriteTemplate[] @relation("FavoriteTemplateAccount")

  /// Plantillas de transferencia que llegan a esta cuenta.
  incomingFavoriteTemplates FavoriteTemplate[] @relation("FavoriteTemplateToAccount")

  /// El nombre tiene que ser único: dos cuentas llamadas "Efectivo" harían
  /// que el usuario no sepa cuál está eligiendo.
  @@unique([name])
  @@index([archived, kind])
}

// ─────────────────────────────────────────────────────────────────────────────
// Category — para qué fue
// ─────────────────────────────────────────────────────────────────────────────

/// Categoría de un movimiento. Sólo aplica a INCOME y EXPENSE.
model Category {
  id String @id @default(cuid())

  /// El nombre tal como lo escribió la persona: "Comida".
  name String

  /// El nombre normalizado (sin mayúsculas, sin acentos, sin espacios de más):
  /// "comida".
  ///
  /// POR QUÉ EXISTE ESTE CAMPO: el esquema anterior tenía `@@unique([name])`,
  /// que en Postgres es SENSIBLE A MAYÚSCULAS. Escribir "Comida" y después
  /// "comida" creaba DOS categorías distintas, y el gráfico de gastos partía
  /// el mismo concepto en dos porciones. Contra eso se agrega una columna
  /// normalizada con el índice único encima. El nombre real se conserva para
  /// mostrarlo; la deduplicación se hace sobre la versión normalizada.
  normalizedName String

  kind CategoryKind

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements Movement[]

  /// Reglas de recurrencia que categorizan así sus ocurrencias. Se crean con la
  /// misma deduplicación por nombre normalizado que los movimientos.
  recurrenceRules RecurrenceRule[]

  /// Plantillas/favoritos que precargan esta categoría.
  favoriteTemplates FavoriteTemplate[]

  @@unique([normalizedName])
  @@index([kind])
}

// ─────────────────────────────────────────────────────────────────────────────
// Movement — la plata que se mueve
// ─────────────────────────────────────────────────────────────────────────────

/// Un movimiento de dinero.
model Movement {
  id String @id @default(cuid())

  kind MovementKind

  /// Monto SIEMPRE POSITIVO. El signo lo determina `kind`, no el número.
  ///
  /// Guardar el monto con signo permitiría estados imposibles: un EXPENSE de
  /// −500 sería un gasto que suma plata. Manteniendo el signo en el tipo, el
  /// dato no puede contradecirse a sí mismo. Hay un CHECK en la base que lo
  /// hace cumplir (ver la migración).
  amount Decimal @db.Decimal(18, 2)

  /// Fecha de CALENDARIO: sin hora, sin zona horaria. Ver la nota de arriba.
  date DateTime @db.Date

  description String @default("")

  /// Categoría. Obligatoria en INCOME y EXPENSE; prohibida en TRANSFER.
  /// `onDelete: SetNull` porque borrar una categoría no debería borrar el
  /// movimiento: el gasto existió aunque ya no te interese cómo lo agrupaste.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Cuenta de origen:
  ///   INCOME   → dónde ENTRA la plata
  ///   EXPENSE  → de dónde SALE
  ///   TRANSFER → de dónde SALE
  ///
  /// `onDelete: Restrict` es deliberado: la base se niega a borrar una cuenta
  /// que tiene movimientos. La alternativa (Cascade) borraría tu historial sin
  /// avisar, y SetNull dejaría movimientos sin cuenta — es decir, plata que
  /// apareció de la nada.
  accountId String
  account   Account @relation("MovementFromAccount", fields: [accountId], references: [id], onDelete: Restrict)

  /// Sólo TRANSFER: la cuenta de DESTINO.
  /// En INCOME y EXPENSE es NULL (hay un CHECK que lo exige).
  toAccountId String?
  toAccount   Account? @relation("MovementToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)

  /// La regla de recurrencia que POSTEÓ este movimiento. NULL en los manuales.
  ///
  /// ───────────────────────────────────────────────────────────────────────────
  /// POR QUÉ ES UNA RELACIÓN Y NO UN CAMPO `origin` CON VALORES
  /// ───────────────────────────────────────────────────────────────────────────
  /// "Este movimiento vino de una regla" ya está dicho por este id: un enum
  /// `origin { MANUAL, RECURRENCE, LOAN_INSTALLMENT, CARD_STATEMENT, IMPORT }`
  /// repetiría esa información en un segundo campo que puede contradecirla
  /// (`origin = MANUAL` con `recurrenceRuleId` cargado) y prometería cuatro
  /// orígenes que ningún camino de la app escribe todavía.
  ///
  /// La equivalencia es exacta: `recurrenceRuleId != null` ⇔ el movimiento lo
  /// posteó una regla.
  ///
  /// `onDelete: Restrict`: una regla con movimientos NO se borra. Borrarla
  /// dejaría movimientos huérfanos —plata que existe sin la regla que la
  /// explica— y el historial es el producto (mismo criterio que `Account`).
  recurrenceRuleId String?
  recurrenceRule   RecurrenceRule? @relation("MovementRecurrence", fields: [recurrenceRuleId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// La ocurrencia que este movimiento cumplió, si vino de una regla.
  recurrenceOccurrence RecurrenceOccurrence?

  /// El plan en cuotas que este movimiento compró, si es la compra de un plan.
  /// La relación es 1-a-1: un movimiento no puede ser la compra de dos planes.
  cardPlanPurchase CardPlan? @relation("CardPlanPurchase")

  /// El resumen que este movimiento pagó, si es el pago de un resumen.
  statementPayment Statement? @relation("StatementPayment")

  // Índices pensados para las consultas reales de la app:
  // ordenar por fecha, filtrar por tipo+mes, y calcular el saldo de una cuenta.
  @@index([date])
  @@index([kind, date])
  @@index([accountId, date])
  @@index([toAccountId, date])
  @@index([categoryId, date])
  /// "Los movimientos de esta regla": lo que muestra la ficha de una regla.
  @@index([recurrenceRuleId, date])
}

// ─────────────────────────────────────────────────────────────────────────────
// RecurrenceRule — "todos los meses, el día 1"
// ─────────────────────────────────────────────────────────────────────────────

/// Una regla de recurrencia: la promesa de que algo pasa cada tanto.
///
/// ─────────────────────────────────────────────────────────────────────────────
/// REGLA + INSTANCIAS (la decisión central de la Fase 3)
/// ─────────────────────────────────────────────────────────────────────────────
/// La regla describe el CALENDARIO (qué días vence, con qué frecuencia, hasta
/// cuándo) y NO contiene plata. La plata aparece recién cuando una ocurrencia
/// se postea, y queda en `Movement` como cualquier otro movimiento.
///
/// Esa separación es lo que hace posible el criterio de aceptación 4: una
/// ocurrencia futura o pendiente no es un movimiento, así que no entra en
/// ningún reporte de plata real (totales, patrimonio, reconciliación) porque
/// esos reportes leen `Movement` y nada más.
///
/// ─────────────────────────────────────────────────────────────────────────────
/// POR QUÉ NO HAY `nextOccurrence` (el boceto del ROADMAP lo tenía)
/// ─────────────────────────────────────────────────────────────────────────────
/// Un cursor guardado es un segundo origen de verdad frente a las ocurrencias
/// ya materializadas, y el día que difieran (un borrado, una edición, un bug)
/// el generador saltearía fechas o las repetiría en silencio. El "desde dónde
/// sigo" se DERIVA del último `dueDate` de `RecurrenceOccurrence`, que es el
/// registro que ya existe. Mismo criterio que el saldo de una cuenta, que se
/// calcula y no se guarda (ver `GET /api/accounts`).
///
/// ─────────────────────────────────────────────────────────────────────────────
/// LA SEMÁNTICA DE `dayOfMonth` (el ancla)
/// ─────────────────────────────────────────────────────────────────────────────
/// El día del mes se guarda como ANCLA (1..31) y se clampea contra el mes
/// concreto cada vez: día 31 → 30 de abril, 28/29 de febrero y **de vuelta a
/// 31** en marzo. Clampear el resultado anterior en vez del ancla dejaría la
/// regla pegada al 28 para siempre después del primer febrero.
///
/// `dayOfMonth` nulo significa "el día de `startDate`". Sólo tiene sentido en
/// MONTHLY y YEARLY; en DAILY y WEEKLY la API lo rechaza porque un parámetro
/// que no hace nada es una mentira de la interfaz.
model RecurrenceRule {
  id String @id @default(cuid())

  /// Nombre que ve la persona: "Alquiler", "Sueldo". Es también la
  /// descripción que llevan los movimientos que postea la regla.
  title String

  kind MovementKind

  /// Monto SIEMPRE POSITIVO, igual que en `Movement`. El signo lo da `kind`.
  /// Un CHECK en la base lo hace cumplir.
  amount Decimal @db.Decimal(18, 2)

  /// Cuenta de origen (o donde entra el ingreso). Igual que en `Movement`.
  accountId String
  account   Account @relation("RecurrenceRuleAccount", fields: [accountId], references: [id], onDelete: Restrict)

  /// Sólo TRANSFER: cuenta de destino. Un CHECK lo exige, como en `Movement`.
  toAccountId String?
  toAccount   Account? @relation("RecurrenceRuleToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)

  /// Obligatoria en INCOME y EXPENSE, prohibida en TRANSFER (CHECK).
  ///
  /// Es obligatoria por una razón concreta: el movimiento posteado tiene que
  /// pasar el CHECK de `Movement` y esa regla es la misma. Si la regla pudiera
  /// no tener categoría, el generador explotaría recién al postear.
  ///
  /// El FK es `SetNull`, pero una categoría usada por una regla NO se puede
  /// borrar: el borrado intenta dejar `categoryId` en NULL, la fila resultante
  /// viola `recurrence_shape_by_kind` y Postgres rechaza el DELETE entero. El
  /// estado "regla sin categoría" no llega a existir (verificado en los tests
  /// de integración de la Fase 3).
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  freq RecurFreq

  /// Cada cuántas unidades de `freq`. Debe ser >= 1 (CHECK).
  interval Int @default(1)

  /// Ancla del día del mes (1..31). NULL = el día de `startDate`.
  /// Sólo MONTHLY y YEARLY; un CHECK lo exige.
  dayOfMonth Int?

  /// Primer día en que la regla puede tener una ocurrencia. Ninguna fecha
  /// anterior existe: una regla no tiene pasado antes de empezar.
  startDate DateTime @db.Date

  /// Última fecha inclusive. NULL = sin fin.
  endDate DateTime? @db.Date

  /// Cuántas ocurrencias produce la regla EN TOTAL, contando las saltadas
  /// (saltar no deshace la ocurrencia: la marca). NULL = sin límite.
  ///
  /// El tope se aplica contra las ocurrencias YA MATERIALIZADAS, no contra una
  /// cuenta que lleve el generador: la tabla de ocurrencias es el registro.
  count Int?

  postingMode PostingMode @default(NOTIFY)

  status RecurrenceRuleStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// El calendario ya materializado: una fila por fecha.
  occurrences RecurrenceOccurrence[]

  /// Los movimientos que esta regla posteó.
  movements Movement[] @relation("MovementRecurrence")

  /// El generador busca por estado; la bandeja, por (estado, fecha) abajo.
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// RecurrenceOccurrence — el registro de "qué pasó con esta fecha"
// ─────────────────────────────────────────────────────────────────────────────

/// Una fecha del calendario de una regla, con su estado.
///
/// ─────────────────────────────────────────────────────────────────────────────
/// POR QUÉ LAS OCURRENCIAS SE PERSISTEN (y no se calculan al vuelo)
/// ─────────────────────────────────────────────────────────────────────────────
/// Tres cosas necesitan memoria propia, y ninguna se puede deducir del
/// calendario:
///
///   1. SALTAR una ocurrencia. Si no hubiera fila, saltar sería "no hacer
///      nada" y la próxima corrida la volvería a crear: el pasado se
///      reescribiría solo. La marca es la fila con `status = SKIPPED`.
///   2. El POSTEO. `movementId` dice cuál movimiento la cumplió, y el vínculo
///      es único en los dos sentidos (ver los índices).
///   3. El "desde dónde sigo" del generador: el último `dueDate` materializado.
///
/// ─────────────────────────────────────────────────────────────────────────────
/// EL DOBLE POSTEO ES IMPOSIBLE POR CONSTRUCCIÓN
/// ─────────────────────────────────────────────────────────────────────────────
///   · `@@unique([ruleId, dueDate])` → una fecha de una regla existe UNA vez.
///     Dos corridas simultáneas del generador insertan lo mismo y la segunda no
///     puede duplicarlo (`createMany ... skipDuplicates` no es la única
///     defensa: la base lo rechaza).
///   · `movementId @unique` → un movimiento no puede ser la respuesta de dos
///     ocurrencias.
///   · El posteo pasa por un `updateMany` condicionado a `status = PENDING`,
///     así que dos pedidos simultáneos de "aceptar" se serializan en la fila y
///     sólo uno crea el movimiento.
model RecurrenceOccurrence {
  id String @id @default(cuid())

  ruleId String
  rule   RecurrenceRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  /// La fecha del calendario a la que corresponde esta ocurrencia.
  dueDate DateTime @db.Date

  status RecurrenceOccurrenceStatus @default(PENDING)

  /// Cuándo se posteó / se saltó. Queda el cuándo, no sólo el qué.
  postedAt  DateTime?
  skippedAt DateTime?

  /// El movimiento que la cumplió. Único: un movimiento responde a una sola
  /// ocurrencia. `onDelete: SetNull` porque borrar un movimiento (que la app
  /// permite: un movimiento mal cargado se puede volver a cargar) reabre la
  /// ocurrencia — el handler la devuelve a PENDING en la misma transacción, y
  /// si algo fallara, un `NULL` es más honesto que un id que ya no existe.
  movementId String?   @unique
  movement   Movement? @relation(fields: [movementId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// La fecha de una regla es única. Ver arriba: es la mitad de la garantía
  /// de que un doble posteo no puede existir.
  @@unique([ruleId, dueDate])
  /// La bandeja de pendientes: "las próximas sin resolver".
  @@index([status, dueDate])
}

// ═════════════════════════════════════════════════════════════════════════════
// TARJETAS DE CRÉDITO Y CUOTAS — FASE 5
// ═════════════════════════════════════════════════════════════════════════════
//
// La tarjeta YA existe en el modelo: es una cuenta de tipo CREDIT_CARD y su
// saldo ES la deuda. Lo que agrega esta fase son tres cosas:
//
//   1. Los parámetros del resumen (closingDay / dueDay / creditLimit) en la
//      cuenta: sin día de cierre la app no puede decir cuándo cierra ni cuándo
//      vence, y sin límite no puede mostrar utilización.
//   2. Los planes en cuotas (CardPlan + CardPlanItem): "compré en 12 cuotas"
//      como UNA acción, con las cuotas asignadas al resumen que corresponde.
//   3. Los resúmenes (Statement): total del período, cierre, vencimiento y
//      mínimo, con el pago enlazado a la transferencia que lo pagó.
//
// La regla que no cambia: comprar con tarjeta = UN EXPENSE al comprar; pagar
// el resumen = TRANSFER (nunca un gasto). Ver la cabecera del archivo.
// ═════════════════════════════════════════════════════════════════════════════

/// Una compra en cuotas hecha con una tarjeta: "12 cuotas de $10.000".
///
/// ─────────────────────────────────────────────────────────────────────────────
/// POR QUÉ LA COMPRA ES UN SOLO EXPENSE (y no doce gastos mensuales)
/// ─────────────────────────────────────────────────────────────────────────────
/// Comprar $120.000 en 12 cuotas NO crea doce gastos de $10.000: crea UN gasto
/// de $120.000 en la fecha de la compra, que es cuando la plata salió de tu
/// patrimonio y la deuda quedó contraída. El saldo de la cuenta de la tarjeta
/// (−120.000) ES la deuda: si los gastos se postearan cuota a cuota, el día
/// después de comprar deberías 120.000 y la app mostraría 10.000.
///
/// Lo que se reparte por período de resumen son los `CardPlanItem`: CUÁNDO el
/// banco te va a cobrar cada parte. El pago del resumen es una TRANSFER y
/// nunca un gasto (criterio de aceptación 3 de la fase).
model CardPlan {
  id String @id @default(cuid())

  /// La cuenta de la tarjeta. `Restrict`: una tarjeta con planes no se borra.
  accountId String
  account   Account @relation("CardPlanAccount", fields: [accountId], references: [id], onDelete: Restrict)

  /// Qué se compró: "Heladera". Es también la descripción del gasto.
  label String

  /// Lo que sale la compra en total. Los items lo suman EXACTO: el último
  /// absorbe los centavos que deja el reparto `total ÷ N`.
  totalAmount Decimal @db.Decimal(18, 2)

  /// Cantidad de cuotas (1..600, CHECK). Mismo tope que un préstamo.
  installments Int

  /// Cuándo se hizo la compra. Define el PRIMER período de resumen: si cae en
  /// o antes del día de cierre, la primera cuota entra en el resumen que cierra
  /// ese mes; si cae después, en el siguiente (ver `periodOf` en lib/cards.ts).
  purchaseDate DateTime @db.Date

  /// Precio de contado, si la persona lo conoce. Es el dato que permite avisar
  /// que "12 cuotas sin interés" con descuento por pago al contado NO es gratis:
  /// la tasa implícita se calcula con `implicitFinancingRate` (lib/money.ts).
  /// NULL = no se sabe, y entonces la app no inventa una tasa.
  cashPrice Decimal? @db.Decimal(18, 2)

  /// El gasto ÚNICO de la compra. `@unique`: un movimiento no puede ser la
  /// compra de dos planes. El FK es `Restrict`: el movimiento no se borra
  /// dejando al plan sin su compra; para deshacer la compra se borra el plan
  /// entero (que borra sus items y después el movimiento, en una transacción).
  movementId String   @unique
  movement   Movement @relation("CardPlanPurchase", fields: [movementId], references: [id], onDelete: Restrict)

  /// Las cuotas, asignadas cada una a un período de resumen.
  items CardPlanItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, purchaseDate])
}

/// Una cuota de un plan, asignada a un período de resumen.
///
/// El período se identifica por el MES DE CIERRE (periodYear/periodMonth) y no
/// por una fecha: "la cuota 7 va en el resumen que cierra en marzo de 2027".
/// La asignación se deriva del `closingDay` de la tarjeta y es pura: misma
/// compra + mismo cierre → mismo cronograma, sin importar cuándo se calcule.
///
/// No guarda fecha de vencimiento por cuota: el vencimiento es el del resumen
/// (dueDay) y repetirlo acá sería un segundo origen de verdad que puede
/// contradecir al primero.
model CardPlanItem {
  id String @id @default(cuid())

  planId String
  plan   CardPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  /// Número de cuota, 1..N. Único dentro del plan.
  number Int

  /// El mes en que CIERRA el resumen que la factura (1..12, CHECK).
  periodYear  Int
  periodMonth Int

  /// Lo que se paga esa cuota. Todas iguales menos la última, que absorbe el
  /// redondeo: `Σ items == CardPlan.totalAmount`, al centavo.
  amount Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  @@unique([planId, number])
  @@index([periodYear, periodMonth])
}

/// El resumen de un período de una tarjeta: lo que el banco te va a cobrar.
///
/// ─────────────────────────────────────────────────────────────────────────────
/// QUÉ ES (y por qué se persiste)
/// ─────────────────────────────────────────────────────────────────────────────
/// Un resumen es un DOCUMENTO: cierra en una fecha, vence en otra, tiene un
/// total y un pago mínimo. El cierre fija qué compras entran: las posteriores
/// al cierre caen en el período siguiente aunque sean del mismo mes calendario.
/// Por eso el período se identifica por el MES DE CIERRE.
///
/// El total y el mínimo se guardan al materializar el resumen, como el
/// documento del banco; un resumen PAGADO queda congelado (es historia). Los
/// NO pagados se recalculan en cada corrida (`POST /api/cards/statements`),
/// idempotente por la clave única (accountId, periodYear, periodMonth): dos
/// corridas seguidas no duplican ni sorprenden.
///
/// ─────────────────────────────────────────────────────────────────────────────
/// EL PAGO ES UNA TRANSFERENCIA, NUNCA UN GASTO (criterio 3)
/// ─────────────────────────────────────────────────────────────────────────────
/// Pagar un resumen mueve plata del banco a la tarjeta: baja el banco y baja
/// la deuda. El gasto ya se contó cuando se compró (una sola vez). Por eso
/// `paidMovementId` apunta a una TRANSFER.
///
/// `onDelete: SetNull`: borrar el pago deshace el pago — el resumen vuelve a
/// quedar impago (y recalculable). Nunca queda un id apuntando a algo que ya
/// no existe.
model Statement {
  id String @id @default(cuid())

  accountId String
  account   Account @relation("CardStatements", fields: [accountId], references: [id], onDelete: Restrict)

  /// El año y el mes (1..12) de CIERRE del resumen.
  periodYear  Int
  periodMonth Int

  /// La fecha de cierre: fin del período. Las compras hechas EN el día de
  /// cierre entran en ESTE resumen.
  closingDate DateTime @db.Date

  /// La fecha de vencimiento: el primer `dueDay` (clampeado) estrictamente
  /// posterior al cierre. Ver la decisión en la columna `Account.dueDay`.
  dueDate DateTime @db.Date

  /// La suma de lo que se factura: las cuotas de los planes asignadas a este
  /// período + las compras directas con fecha en la ventana del período
  /// (después del cierre anterior, hasta el cierre inclusive).
  totalDue Decimal @db.Decimal(18, 2)

  /// El pago mínimo: 5% del total redondeado hacia arriba al centavo, clampeado
  /// al total (ver `minimumPayment` en lib/cards.ts y la decisión documentada).
  minimumDue Decimal @db.Decimal(18, 2)

  /// El movimiento que lo pagó. NULL = impago.
  paidMovementId String?   @unique
  paidMovement   Movement? @relation("StatementPayment", fields: [paidMovementId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Un resumen por tarjeta y período. Es lo que hace idempotente la corrida.
  @@unique([accountId, periodYear, periodMonth])
  @@index([accountId, dueDate])
}

// ═════════════════════════════════════════════════════════════════════════════
// PRÉSTAMOS — FASE 4
// ═════════════════════════════════════════════════════════════════════════════
//
// El préstamo NO tiene tabla propia: sus parámetros (capital, tasa, cuotas,
// primera fecha y sistema) viven en la cuenta, y el SALDO DE LA CUENTA ES LA
// DEUDA VIVA (decisión del rediseño, no negociable). Lo que agrega esta fase
// es una sola tabla nueva —`Installment`— con el CONTRATO materializado:
// cuánto vence, cuándo y cómo se descompone, cuota por cuota.
//
// ─────────────────────────────────────────────────────────────────────────────
// CONTRATO vs PROYECCIÓN (la decisión que ordena todo)
// ─────────────────────────────────────────────────────────────────────────────
// El cronograma es un DOCUMENTO: lo que se pactó. Una vez escrito no se
// recalcula ni se reescribe — si se recalculara con cada pago extra, la cuota 3
// que ya pagaste "cambiaría" y el contrato tendría dos versiones incompatibles.
//
// El avance NO vive acá: se deriva de los movimientos reales (Σ transferencias
// que entraron al préstamo, definición de la Fase 6) y se mide CONTRA el
// cronograma (`installmentsCoveredBy`). Por eso no hay columna `paid`: el
// estado "pagada" no es un dato que se guarda y puede quedar viejo, es una
// consecuencia de la plata que consta.
//
// ─────────────────────────────────────────────────────────────────────────────
// EXISTE PARA RESPONDER "¿QUÉ CUOTAS TENGO COMPROMETIDAS?"
// ─────────────────────────────────────────────────────────────────────────────
// Sin esta tabla, esa pregunta obliga a recalcular cada cronograma al vuelo
// —y peor: obliga a que cada consumidor lo recalcule igual, con las mismas
// reglas—. Materializado, el compromiso es una consulta: las cuotas impagas
// del mes que viene. El calendario se fija UNA vez, en el alta.
//
// `onDelete: Cascade` en la cuenta: el cronograma es una derivación del
// contrato, no historia. Borrar una cuenta sin movimientos (lo único que la
// app permite borrar) se lleva su cronograma; un movimiento jamás se borra en
// cascada (Restrict), así que el historial no corre riesgo.
// ═════════════════════════════════════════════════════════════════════════════

/// Una cuota del contrato de un préstamo: cuándo vence y cómo se descompone.
model Installment {
  id String @id @default(cuid())

  /// La cuenta del préstamo (LOAN o RECEIVABLE). `Cascade`: ver arriba.
  accountId String
  account   Account @relation("LoanInstallments", fields: [accountId], references: [id], onDelete: Cascade)

  /// Número de cuota, 1..N. Único dentro de la cuenta (CHECK + índice).
  number Int

  /// Fecha de vencimiento: calendario puro (`@db.Date`), sin hora ni zona.
  /// Se fija al materializar (serie mensual con clamp en los calculados; la
  /// fecha declarada en los importados) y no se vuelve a calcular.
  dueDate DateTime @db.Date

  /// Lo que se paga esa cuota. `payment = interest + principal`, exacto: hay
  /// un CHECK que lo exige — descomponer la cuota es el punto de todo el
  /// modelo (sin eso, la cuota entera volvería a contarse como gasto).
  payment Decimal @db.Decimal(18, 2)

  /// La parte que es COSTO REAL. Gasto si el préstamo es tuyo (LOAN), ingreso
  /// si lo diste (RECEIVABLE). Puede ser 0 (alemán/francés con tasa 0, y las
  /// cuotas intermedias del americano y del rotativo por su capital).
  interest Decimal @db.Decimal(18, 2)

  /// La parte que AMORTIZA DEUDA. Transferencia, nunca gasto ni ingreso.
  /// Puede ser 0 (americano y solo interés: el capital va al final o nunca).
  principal Decimal @db.Decimal(18, 2)

  /// El saldo del contrato después de esta cuota. No es la deuda viva —esa es
  /// el saldo de la cuenta— sino lo que el cronograma declara: cierra en 0 en
  /// los cuatro sistemas que amortizan, y queda en el capital original en un
  /// rotativo (la única excepción, documentada en `lib/loans.ts`).
  remainingBalance Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  /// Una cuota por número y préstamo. Es la mitad de la garantía de
  /// idempotencia: re-materializar un cronograma no puede duplicar filas.
  @@unique([accountId, number])
  /// La consulta de compromisos: las cuotas de un préstamo por fecha.
  @@index([accountId, dueDate])
}

// ═════════════════════════════════════════════════════════════════════════════
// PLANTILLAS / FAVORITOS — FASE 7 RONDA 2
// ═════════════════════════════════════════════════════════════════════════════
//
// Una plantilla NO es un movimiento: es la PROMESA de un formulario ya
// completado. No tiene fecha propia, no entra en ningún total y no la toca el
// generador de recurrencia. Lo único que hace es abrir `TransactionForm` con
// los campos cargados para que la persona confirme.
//
// ─────────────────────────────────────────────────────────────────────────────
// POR QUÉ TABLA PROPIA Y NO `RecurrenceRule`
// ─────────────────────────────────────────────────────────────────────────────
// Una recurrencia describe un CALENDARIO (frecuencia, ancla, fin, modo de
// posteo). Una plantilla describe un FORMULARIO (monto, cuenta, categoría,
// nota). Comparten la forma del movimiento, no la semántica: reutilizar la
// tabla de reglas obligaría a inventar una frecuencia falsa para guardar un
// favorito y contaminaría la bandeja de ocurrencias con filas que no vencen.
//
// ─────────────────────────────────────────────────────────────────────────────
// `amount` NULLABLE: "sin monto" es un favorito válido
// ─────────────────────────────────────────────────────────────────────────────
// "Cargar un gasto en la tarjeta" puede no tener un monto típico. Guardar 0
// sería mentir (el monto de un movimiento es siempre positivo); NULL dice
// exactamente lo que pasa: la plantilla completa el resto y deja el monto para
// que lo escriba la persona.
model FavoriteTemplate {
  id String @id @default(cuid())

  /// Nombre visible y buscable: "Café de la mañana".
  name String

  /// Clave de deduplicación (sin mayúsculas, sin acentos, espacios colapsados).
  /// Única en toda la tabla: es single-user, no hay `userId` que compartir.
  normalizedName String

  kind MovementKind

  /// Monto típico, SIEMPRE positivo. NULL = "sin monto": el favorito no lo
  /// precarga y la persona lo escribe.
  amount Decimal? @db.Decimal(18, 2)

  /// Nota que se precarga en el formulario.
  description String @default("")

  /// Categoría opcional (sólo INCOME/EXPENSE). `SetNull`: borrar la categoría
  /// no borra el favorito; simplemente deja de precargarla.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Cuenta de origen. `Cascade`: el favorito es una comodidad, no historia;
  /// si la cuenta se borra (sólo posible sin movimientos), la plantilla que la
  /// apuntaba ya no sirve y se va con ella.
  accountId String
  account   Account @relation("FavoriteTemplateAccount", fields: [accountId], references: [id], onDelete: Cascade)

  /// Sólo TRANSFER: cuenta de destino, distinta de la de origen (CHECK).
  toAccountId String?
  toAccount   Account? @relation("FavoriteTemplateToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)

  /// Se actualiza SÓLO cuando un movimiento se guarda usando esta plantilla.
  /// Ordena la lista (el último usado primero) sin tocar los totales.
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Un nombre normalizado = una plantilla. Es el candado que impide dos
  /// "Café" que la persona no sabría distinguir.
  @@unique([normalizedName])
  /// La lista de favoritos: último usado primero.
  @@index([lastUsedAt])
  @@index([kind])
}
